# Puerto del API Fastify
PORT=3001

# PostgreSQL / Supabase (Opcional). Si está vacío, el API corre en memoria precargado con semillas de `src/db/seed.ts`.
DATABASE_URL=postgresql://usuario:TU_PASSWORD_AQUI@localhost:5432/gumorose_db

# --- IA Modular (Meta / Muse / SAM 3.1) ---
# Si las credenciales están ausentes o con valor mock, el API responde con payloads deterministas sin fallar.
META_API_KEY=TU_META_API_KEY_AQUI
META_BASE_URL=
META_MODEL=
MUSE_IMAGE_ENDPOINT=
MUSE_IMAGE_MODEL=muse-image-open-1.0
MUSE_SPARK_MODEL=meta-models/muse-spark-open-1026
SAM_SEGMENT_ENDPOINT=
VIRTUAL_TRYON_ENDPOINT=
TRYON_CACHE_TTL_HOURS=24

# --- ERP y Event Bus (Diagrama 1) ---
# Webhook externo opcional para sincronización de eventos de planta/pedidos.
# Si está vacío, los eventos quedan en el log interno (`erpEventLog` + GET /api/erp/finance/summary).
ERP_EXTERNAL_WEBHOOK_URL=

# --- Facturación Electrónica SRI (Ecuador) ---
# Ambiente SRI: 'PRUEBAS' (celcer) o 'PRODUCCION' (cel)
GUMOROSE_SRI_ENV=PRUEBAS
# Ruta local al certificado .p12 (NUNCA incluir el archivo .p12 real en el repositorio)
GUMOROSE_SRI_P12_PATH=./certificates/tu_firma_electronica.p12
GUMOROSE_SRI_P12_PASSWORD=TU_CONTRASENA_P12_AQUI
